generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BoatState {
  AVAILABLE
  MAINTENANCE
}

enum SessionType {
  STEADY
  UT2
  UT1
  AT
  INTERVALS
  RACE
  OUTING
}

model Member {
  id           String    @id @default(cuid())
  googleUserId String    @unique
  displayName  String
  email        String    @unique
  squad        String?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("members")
}

model Boat {
  id           String    @id @default(cuid())
  name         String    @unique
  category     String
  yearBuilt    Int?
  weightKg     Float?
  state        BoatState @default(AVAILABLE)
  rackLocation String?
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("boats")
}

model Session {
  id             String       @id @default(cuid())
  memberId       String
  boatId         String
  departedAt     DateTime     @default(now())
  expectedReturn DateTime
  returnedAt     DateTime?
  googleUserId   String?
  distanceMeters Float?
  sessionType    SessionType?
  notes          String?
  createdAt      DateTime     @default(now())

  member Member @relation(fields: [memberId], references: [id])
  boat   Boat   @relation(fields: [boatId], references: [id])

  @@map("sessions")
}
